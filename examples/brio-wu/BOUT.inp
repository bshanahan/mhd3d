# Brio-Wu MHD shock tube along y, mu0=1.
nout=1
timestep=0.1
MXG=2
MYG=2
periodicX=true
[mesh]
nx=8
ny=128
nz=4
dx=2*pi/(nx-4)
dy=1.0/ny
dz=2*pi/nz
ixseps1=-1
ixseps2=-1
symmetricGlobalX=true
symmetricGlobalY=true

[mesh:paralleltransform]
type=identity
[solver]
type=rk3ssp
max_timestep=0.0005
[mhd]
shock_capturing=true
g=2
diagnose=true
dump_metric=true
[mhd:shock]
limiter=mc
glm_ch=2
glm_damping=1
[all]
scale=1
bndry_all=neumann
[density]
function=1-H(y-pi)*0.875
[pressure]
function=1-H(y-pi)*0.9
[v_x]
function=0
[v_y]
function=0
[v_z]
function=0
[Bx]
function=1-2*H(y-pi)
[By]
function=.75
[Bz]
function=0
